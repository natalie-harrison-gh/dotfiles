# OrbStack adds host aliases here when it is installed.
Include ~/.orbstack/ssh/config

# GitHub and GitLab use the fixed SSH account name `git`; the account is
# selected by the authenticated key, not by the profile handle.
Host github.com gitlab.com
  User git
  ForwardAgent no

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  AddKeysToAgent yes
  UseKeychain yes
